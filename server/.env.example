# ── Data source ──────────────────────────────────────────────────────────────
# Which API to read from: auto | analytics | admin | mock  (default: auto)
#   auto      → analytics if ANTHROPIC_ANALYTICS_KEY is set, else admin if
#               ANTHROPIC_ADMIN_KEY is set, else mock.
#   analytics → Claude.ai Enterprise Analytics API (per-user usage, cost,
#               active users, products). Requires ANTHROPIC_ANALYTICS_KEY.
#   admin     → Claude Platform Usage & Cost Admin API. Requires ANTHROPIC_ADMIN_KEY.
#   mock      → realistic mock data, no key needed.
DATA_SOURCE=auto

# ── Claude.ai Enterprise Analytics API (recommended for claude.ai / Claude Code seats) ──
# Analytics API key with the `read:analytics` scope. Sent in the x-api-key header.
# Create one as the org's PRIMARY OWNER in claude.ai → Settings → API
# (https://claude.ai/admin-settings/api-access). Claude Enterprise plan only.
# Surfaces per-user usage/cost, active users, adoption, and per-product metrics.
# Data is available for dates on or after 2026-01-01.
ANTHROPIC_ANALYTICS_KEY=

# ── Claude Platform Usage & Cost Admin API (api.anthropic.com developer usage) ──
# Admin API key (NOT a regular API key). Looks like: sk-ant-admin01-...
# Create one as an org admin: Console → Settings → API keys → Admin keys
# Docs: https://platform.claude.com/docs/en/manage-claude/admin-api-keys
ANTHROPIC_ADMIN_KEY=

# ── Local analysis model (optional; used for the last-month AI analysis panel) ──
# OpenAI-compatible local inference server, such as LM Studio.
ANALYSIS_BASE_URL=http://localhost:1234/v1
ANALYSIS_MODEL=lmstudio-community/Meta-Llama-3.1-8B-Instruct-GGUF/Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf
ANALYSIS_API_KEY=

# Anthropic API version header. Rarely needs changing.
ANTHROPIC_VERSION=2023-06-01

# Base URL for the Anthropic API (override only for proxies/testing).
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8787

# Optional Postgres persistence for dashboard snapshots and history backfills.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/claude_usage_dashboard

# Set to false to disable Postgres reads/writes while keeping DATABASE_URL set.
PERSIST_HISTORY=true

# Max number of missing daily snapshots to fetch in parallel during startup warmup.
# Clamped to 1..16.
HISTORY_WARMUP_CONCURRENCY=4

# Force mock data even if a key is present (true/false).
USE_MOCK=false
